# Simulator on the same computer may use localhost. A physical phone must use
# http://<laptop-LAN-IP>:<server-port>/api/v1 on the same reachable network.
# Deployed builds must use the public Express API URL, for example https://api.example.org/api/v1.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Public Auth settings only; never put DATABASE_URL or a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
