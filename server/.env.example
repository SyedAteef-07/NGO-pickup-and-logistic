PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=C:/path/to/development-db-ca.crt
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Allowlist this exact public web URL in Supabase Auth Redirect URLs.
VOLUNTEER_INVITE_REDIRECT_URL=http://localhost:5173/accept-invite
LOCATION_RETENTION_DAYS=30
CORS_ORIGIN=http://localhost:5173
